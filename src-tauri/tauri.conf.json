{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "job-trackwsp",
  "version": "0.1.0",
  "identifier": "xyz.aakwsp.job-trackwsp",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "job-trackwsp",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#141216"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
